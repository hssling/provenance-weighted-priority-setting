__pycache__/
*.pyc
.superpowers/
outputs/
.pytest_cache/

# publisher guideline PDFs: copyrighted, keep local
manuscript/submission/*.pdf

# Author-only files: signed forms, Elsevier declaration downloads, Word lock files.
# Kept on disk, never committed: the repository is public.
manuscript/submission/**/*.pdf
manuscript/submission/**/declarationStatement*
manuscript/submission/**/~$*

# WHO report-repository snapshots: fetched at pinned commits by tools/fetch_vintages.py,
# verified by SHA-256 against data/vintages/vintage_manifest.csv. The source repositories
# carry no licence, so the files are not redistributed here.
data/vintages/raw/
data/vintages/csv/

# The author's signature image, and anything signed with it, never goes to the public repository.
manuscript/submission/**/*sign*.png
manuscript/submission/**/*sign*.jpg
manuscript/submission/**/*_signed.*

# Suggested reviewers are named in the uploaded manuscript only, never in the public repository.
# The built manuscripts that carry them are regenerated by manuscript/build_submission.py.
manuscript/private/
manuscript/submission/paper_b_tmih/03_manuscript.*
manuscript/submission/paper_b_tmih/91_manuscript_blinded.*

# Journal of Clinical Epidemiology version of paper B: the manuscript sources and the upload set
# stay local. Only the tooling that builds and checks them is committed.
manuscript/manuscript_b_jce.md
manuscript/tables_paper_b_jce.md
manuscript/supplementary_paper_b_jce.md
manuscript/supplementary_paper_b_jce_template.md
manuscript/submission/paper_b_jce/

# Publishers' guides (copyright), kept beside the manuscripts for reference only.
manuscript/*.pdf
manuscript/*_guide_*.txt

# Manuscript texts stay local from 26 Nov 2026: only the code, data, analysis plan and checks
# are public. The checks read these files from the author's copy.
manuscript/submission/
manuscript/manuscript_*.md
manuscript/supplementary_paper_*.md
manuscript/tables_paper_*.md
